rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() {
      return request.auth != null;
    }

    // Yönetici: yoneticiler/{uid} belgesi olan kullanıcı.
    // Bu belgeler yalnızca Firebase konsolundan eklenebilir.
    function yonetici() {
      return girisli() && exists(/databases/$(database)/documents/yoneticiler/$(request.auth.uid));
    }

    // Kullanıcı profilleri: herkes kendi profilini okur/yazar, yönetici hepsini okur
    match /kullanicilar/{uid} {
      allow read: if girisli() && (request.auth.uid == uid || yonetici());
      // Profil fotoğrafı küçültülmüş olarak belgede durur; çok büyük yazılmasın
      allow write: if girisli() && request.auth.uid == uid
        && (!('foto' in request.resource.data.profil) || request.resource.data.profil.foto.size() < 200000);
    }

    // Yönetici listesi: kişi yalnızca kendisinin yönetici olup olmadığını görebilir
    match /yoneticiler/{uid} {
      allow read: if girisli() && request.auth.uid == uid;
      allow write: if false;
    }

    // Klip geçerli mi? Kaynak ya YouTube (youtube: 11 karakterlik kimlik)
    // ya da kendi videomuz (video: https adresi — yüklenen dosya, Google Drive, Dropbox…)
    function klipGecerli(d) {
      return d.start is number && d.end is number && d.end > d.start
        && d.arapca is string && d.dogru is string && d.yanlis is string
        && (('youtube' in d && d.youtube is string)
            || ('video' in d && d.video is string && d.video.matches('https://.+')));
    }

    // Klipler: herkes okur (oyun için), yalnızca yönetici ekler/düzenler/siler
    match /klipler/{id} {
      allow read: if true;
      allow create, update: if yonetici() && klipGecerli(request.resource.data);
      allow delete: if yonetici();
    }
  }
}
